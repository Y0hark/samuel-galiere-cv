---
import { ui, site, type Lang } from '../lib/content';
const { lang } = Astro.props as { lang: Lang };
---
<figure class="portrait-wrap" data-reveal>
  <picture>
    <source type="image/webp" srcset={`${site.portraitWebp} 800w`} sizes="(max-width: 48rem) 80vw, 360px" />
    <img class="portrait" src={site.portrait} srcset={`${site.portrait400} 400w, ${site.portrait} 800w`} sizes="(max-width: 48rem) 80vw, 360px" alt={ui(lang).portraitAlt} width="800" height="800" loading="lazy" decoding="async" />
  </picture>
  <span class="ring" aria-hidden="true"></span>
</figure>
