---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseCard from '../components/CaseCard.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Portrait from '../components/Portrait.astro';
import LegalBlock from '../components/LegalBlock.astro';
import { LANGS, SLUGS, DEFAULT_LANG, getPage, ui, type Lang } from '../lib/content';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    SLUGS.map((s) => {
      const parts = [lang === DEFAULT_LANG ? '' : lang, s].filter(Boolean);
      return { params: { slug: parts.length ? parts.join('/') : undefined }, props: { lang, s } };
    })
  );
}
const { lang, s } = Astro.props as { lang: Lang; s: string };
const { data, Content } = getPage(lang, s);
const t = ui(lang);
---
<Base lang={lang} slug={s} title={data.title} description={data.description}>
  {s === '' ? (
    <>
      <Hero title={data.heroTitle} text={data.heroText} />
      <div class="wrap section"><Content /></div>
      <div class="wrap grid">{data.services.map((x: any) => <ServiceCard {...x} />)}</div>
    </>
  ) : (
    <div class="wrap section">
      <h1>{data.title}</h1>
      {s === 'a-propos' && <Portrait lang={lang} />}
      {s === 'mentions-legales' && <LegalBlock lang={lang} />}
      <Content />
      {s === 'services' && <div class="grid">{data.services.map((x: any) => <ServiceCard {...x} />)}</div>}
      {s === 'cas' && <div class="grid">{data.cases.map((x: any) => <CaseCard {...x} contextLabel={t.casLabel} resultLabel={t.resultLabel} />)}</div>}
      {s === 'contact' && <ContactBlock lang={lang} />}
    </div>
  )}
</Base>
